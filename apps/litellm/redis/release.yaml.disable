---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: litellm-redis
  namespace: litellm
spec:
  interval: 5m
  timeout: 5m
  chartRef:
    kind: OCIRepository
    name: redis
    namespace: redis-operator
  values:
    redisStandalone:
      redisSecret:
        secretName: ""
        secretKey: ""
      resources: {}
        # requests:
        #   cpu: 100m
        #   memory: 128Mi
        # limits:
        #   cpu: 100m
        #   memory: 128Mi
